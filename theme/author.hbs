{{!< default}}

{{#author}}
<section class="hero">
    <div class="container">
        <p class="hero-eyebrow">Author</p>
        <h1 class="hero-title">{{name}}</h1>
        {{#if bio}}<p class="hero-subtitle">{{bio}}</p>{{/if}}
    </div>
</section>
{{/author}}

<section class="post-list-section">
    <div class="container">
        <div class="post-grid">
            {{#foreach posts}}
                {{> "post-card"}}
            {{/foreach}}
        </div>
        {{pagination}}
    </div>
</section>
